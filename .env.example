# Campo Digital local PostgreSQL/PostGIS
APP_ENV=development
# Copy to .env for local development. Never commit .env.

POSTGRES_DB=campo_digital
POSTGRES_USER=campo_digital
POSTGRES_PASSWORD=replace-with-local-random-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Google Workspace sign-in ---------------------------------------------
# Optional locally: development also offers the seeded dev-login identities.
# Required under APP_ENV=production (startup fails closed without them).
# See docs/platform/google-workspace-oauth-handoff.md and ADR-008.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The browser-facing base that routes to this API. The OAuth redirect URI is
# this value + /auth/google/callback and must match the Google OAuth client
# byte for byte. Behind the portal's same-origin /api/* proxy, include /api:
# GOOGLE_REDIRECT_BASE_URL=http://localhost:5100/api
# The `hd` claim an id_token must carry, exactly, to be accepted.
# GOOGLE_WORKSPACE_DOMAIN=campodigital.cl
# Encrypts the short-lived sign-in flow cookie (a Fernet key):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PLATFORM_TOKEN_ENCRYPTION_KEY=
# One-time bootstrap: this address receives ADMIN on the listed products at
# its first sign-in, only while it holds no grant. Set both or neither.
# PLATFORM_BOOTSTRAP_ADMIN_EMAIL=
# PLATFORM_BOOTSTRAP_ADMIN_PRODUCTS=transelect
