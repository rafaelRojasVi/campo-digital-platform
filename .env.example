# Campo Digital local PostgreSQL/PostGIS
APP_ENV=development
# Copy to .env for local development. Never commit .env.

POSTGRES_DB=campo_digital
POSTGRES_USER=campo_digital
POSTGRES_PASSWORD=replace-with-local-random-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Transelec hosted pilot administration.
# Use a long random value in hosted environments. This protects upload/restore
# mutations; viewer access should also be gated by the hosting access layer.
CAMPO_TRANSELEC_ADMIN_TOKEN=replace-with-long-random-admin-token

# Optional local-development override. When set, read endpoints parse this
# workbook directly instead of the active hosted PostgreSQL snapshot.
# CAMPO_TRANSELEC_WORKBOOK_PATH=/absolute/path/to/PlanillaMaestra.xlsx

# Maximum accepted workbook upload size in bytes. Defaults to 64 MiB.
# CAMPO_TRANSELEC_MAX_UPLOAD_BYTES=67108864

# Private object storage for uploaded workbook bytes (never PostgreSQL).
# "local" (default) writes content-addressed files under a gitignored
# directory; "gcs" uses a private Cloud Storage bucket in hosted environments.
CAMPO_OBJECT_STORE_BACKEND=local
# CAMPO_OBJECT_STORE_LOCAL_ROOT=var/transelec-object-store
# CAMPO_OBJECT_STORE_GCS_BUCKET=campo-digital-transelec-pilot-objects

# Cloud SQL Unix-socket path, e.g. /cloudsql/<PROJECT>:<REGION>:<INSTANCE>.
# Leave unset for local TCP PostgreSQL.
# POSTGRES_UNIX_SOCKET_PATH=/cloudsql/project:region:instance
