# Campo Digital local PostgreSQL/PostGIS
APP_ENV=development
# Copy to .env for local development. Never commit .env.

POSTGRES_DB=campo_digital
POSTGRES_USER=campo_digital
POSTGRES_PASSWORD=replace-with-local-random-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Transelec hosted pilot administration.
# Use a long random value in hosted environments. This protects upload/restore
# mutations; viewer access should also be gated by the hosting access layer.
CAMPO_TRANSELEC_ADMIN_TOKEN=replace-with-long-random-admin-token

# Optional local-development override. When set, read endpoints parse this
# workbook directly instead of the active hosted PostgreSQL snapshot.
# CAMPO_TRANSELEC_WORKBOOK_PATH=/absolute/path/to/PlanillaMaestra.xlsx
